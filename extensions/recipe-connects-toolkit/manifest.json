{
  "manifest_version": 3,
  "name": "Recipe Connects Toolkit",
  "version": "0.1.0",
  "description": "Clean tracking params from recipe links and open a print-friendly view of the current page. No account, no data collection.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Recipe Connects Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "host_permissions": ["<all_urls>"]
}