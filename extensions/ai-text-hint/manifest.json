{
  "manifest_version": 3,
  "name": "AI Pattern & Slop Checker (Local & Private)",
  "version": "0.1.3",
  "description": "On-device pattern & slop hints for page text. Nothing uploaded. Not proof of AI.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Pattern & Slop Checker (Local & Private)",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"]
}