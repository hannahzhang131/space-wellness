{
  "manifest_version": 3,
  "name": "AI Text Hint",
  "version": "0.1.2",
  "description": "Informational hints about text on web pages. Not a guarantee of AI authorship.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Text Hint",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"]
}